# Server (node server/index.ts)
PORT=8797
# Ledger AI proxy: base URL, an lk_ proxy token granted to the model endpoint, and the
# model endpoint (purpose) id that runs GPT Image 2 / 2.1 on images/generations.
LEDGER_URL=
LEDGER_TOKEN=
LEDGER_PURPOSE_ID=
GENERATIONS_PER_HOUR=20
ALLOWED_ORIGINS=capacitor://localhost,https://localhost,http://localhost:5180

# Web/native build: where the app calls /api. Empty = same origin (web). Native builds
# must set the hosted server URL.
VITE_API_BASE=
